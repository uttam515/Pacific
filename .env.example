# ==========================================
# OFFGRID Monorepo — Environment Variables Template
# Copy this file to .env in each respective service/app as needed.
# DO NOT commit real secrets or credentials to git.
# ==========================================

# ------------------------------------------
# Central Backend (Engineer 1)
# ------------------------------------------
NODE_ENV=development
API_PORT=4000
WS_PORT=4001
DATABASE_URL=postgresql://offgrid:offgrid@localhost:5432/offgrid_db

# JWT & Cryptographic Identity
JWT_SECRET=replace-with-a-secure-random-secret-in-production
SYSTEM_NETWORK_KEY=replace-with-mesh-psk-if-applicable

# ------------------------------------------
# Web Dashboard (Engineer 1)
# ------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001

# ------------------------------------------
# Network Node / Sync Engine (Engineer 1)
# ------------------------------------------
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_MS=5000
GATEWAY_DISCOVERY_INTERVAL_MS=10000

# ------------------------------------------
# Native Clients (iOS & Android Local Gateway Defaults)
# ------------------------------------------
DEFAULT_GATEWAY_URL=http://192.168.1.100:4000
DEFAULT_GATEWAY_WS=ws://192.168.1.100:4001
BLE_SERVICE_UUID=7B6E0001-C72B-4E36-96F1-30AA4B848694
BLE_CHARACTERISTIC_TX_UUID=7B6E0002-C72B-4E36-96F1-30AA4B848694
BLE_CHARACTERISTIC_RX_UUID=7B6E0003-C72B-4E36-96F1-30AA4B848694
MULTIPEER_SERVICE_TYPE=offgrid-mesh
